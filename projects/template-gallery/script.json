{
  "id": "template-gallery",
  "title": "Template gallery",
  "channel": "MONEY MECHANICS",
  "about": "Every scene template once, with made-up example figures. It is the test that a project builds from a script and storyboard alone, and the reference for writing new storyboards. Build it wide: pipeline/build.sh template-gallery. Build it tall: pipeline/build.sh template-gallery --cut tall",
  "voice": {
    "engine": "kokoro",
    "voice": "af_heart",
    "speed": 1.0
  },
  "music": {
    "track": "thinking-music",
    "underVoice": 22
  },
  "pauses": {
    "line": 0.3,
    "scene": 0.6,
    "beat": 1.1
  },
  "photos": {
    "rig": {
      "file": "File:Ekofisk 2-4 K (DEX KF 000635).jpg"
    }
  },
